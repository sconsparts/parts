Import('*')
# a launcher given with an argument, as ccache and sccache often are
env['CC_LAUNCHER'] = env.File('#launch.sh').abspath + ' --tag native'
env['CXX_LAUNCHER'] = env.File('#launch.sh').abspath
env.InstallBin(env.Program('native', 'native.c'))
env.InstallBin(env.Program('native_cxx', 'native_cxx.cpp'))
