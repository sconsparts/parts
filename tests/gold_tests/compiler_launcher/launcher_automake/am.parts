Import('*')
PartName('am')

@build
def source(env):
    # a launcher with arguments and an env prefix reaches configure's CC= as
    # one argument; configure splits CC at whitespace, so no word has a space
    env['CC_LAUNCHER'] = 'env CCACHE_DIR=cache-dir ' + env.File('#launch.sh').abspath + ' --tag automake'
    # the configure here is hand written, so no autoreconf and no autotools
    env.AutoMake(autoreconf=None)
